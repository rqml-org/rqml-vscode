# The extension depends on the published @rqml/core package. install-links keeps
# any file:/link: dependency installed as a real copy rather than a symlink, so
# `vsce package` never follows a symlink outside the package root and fails with
# "invalid relative path". Retained as a harmless safeguard after the move from a
# local file:../../rqml-core dependency to the registry @rqml/core package.
install-links=true
