{
  "name": "rqml-vscode",
  "displayName": "RQML for VS Code",
  "description": "Requirements that live in your repository. Browse, trace, and validate RQML specifications, see coverage and traceability at a glance, and keep intent under version control alongside the code your agents write.",
  "version": "1.1.8",
  "publisher": "rqml",
  "license": "MIT",
  "icon": "resources/RQML_logo_purple_128x128.png",
  "homepage": "https://rqml.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/rqml-org/rqml-vscode",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/rqml-org/rqml-vscode/issues"
  },
  "engines": {
    "vscode": "^1.108.1",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization",
    "AI"
  ],
  "keywords": [
    "rqml",
    "requirements",
    "traceability",
    "requirements engineering",
    "specification",
    "spec drift",
    "traceability matrix",
    "coverage",
    "verification",
    "adr",
    "architecture decision record",
    "coding agent",
    "compliance"
  ],
  "galleryBanner": {
    "color": "#8568ab",
    "theme": "dark"
  },
  "activationEvents": [
    "onView:rqmlTree",
    "onView:rqmlDetails",
    "onView:rqmlTraces",
    "onView:rqmlAgentView",
    "workspaceContains:**/*.rqml",
    "onLanguage:rqml",
    "onCommand:rqml-vscode.initSpec",
    "onCommand:rqml-vscode.openDocumentView",
    "onCommand:rqml-vscode.openTraceView",
    "onCommand:rqml-vscode.openGridView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "rqml.statusDraft",
        "description": "Icon color for RQML elements with draft status",
        "defaults": {
          "dark": "#e2b714",
          "light": "#b8860b",
          "highContrast": "#ffd700",
          "highContrastLight": "#8b6914"
        }
      },
      {
        "id": "rqml.statusReview",
        "description": "Icon color for RQML elements with review status",
        "defaults": {
          "dark": "#e87d2f",
          "light": "#c55a11",
          "highContrast": "#ff8c00",
          "highContrastLight": "#a04a0a"
        }
      },
      {
        "id": "rqml.statusApproved",
        "description": "Icon color for RQML elements with approved status",
        "defaults": {
          "dark": "#4ec957",
          "light": "#2d8e36",
          "highContrast": "#00ff41",
          "highContrastLight": "#1a6b24"
        }
      },
      {
        "id": "rqml.statusDeprecated",
        "description": "Icon color for RQML elements with deprecated status",
        "defaults": {
          "dark": "#6b6b6b",
          "light": "#999999",
          "highContrast": "#808080",
          "highContrastLight": "#666666"
        }
      }
    ],
    "commands": [
      {
        "command": "rqml-vscode.initSpec",
        "title": "RQML: Init Spec"
      },
      {
        "command": "rqml-vscode.selectSpec",
        "title": "RQML: Select Spec File",
        "icon": "$(list-selection)"
      },
      {
        "command": "rqml-vscode.openDocumentView",
        "title": "Open RQML Document",
        "icon": "$(file)"
      },
      {
        "command": "rqml-vscode.openTraceView",
        "title": "Open Traceability Map",
        "icon": "$(graph)"
      },
      {
        "command": "rqml-vscode.openGridView",
        "title": "Open Requirements Grid",
        "icon": "$(table)"
      },
      {
        "command": "rqml-vscode.addItem",
        "title": "Add RQML Item",
        "icon": "$(add)"
      },
      {
        "command": "rqml-vscode.renameItem",
        "title": "Rename"
      },
      {
        "command": "rqml-vscode.deleteItem",
        "title": "Delete"
      },
      {
        "command": "rqml-vscode.gotoDefinition",
        "title": "Go to Definition"
      },
      {
        "command": "rqml-vscode.export",
        "title": "Export Spec...",
        "icon": "$(export)"
      },
      {
        "command": "rqml-vscode.openSettings",
        "title": "RQML: Open Settings"
      },
      {
        "command": "rqml-vscode.showLogs",
        "title": "RQML: Show Logs"
      },
      {
        "command": "rqml-vscode.configureApiKey",
        "title": "RQML: Configure API Key"
      },
      {
        "command": "rqml-vscode.selectLlmProvider",
        "title": "RQML: Select LLM Provider"
      },
      {
        "command": "rqml-vscode.addLlmProvider",
        "title": "RQML: Add LLM Provider",
        "icon": "$(add)"
      },
      {
        "command": "rqml-vscode.removeLlmProvider",
        "title": "RQML: Remove LLM Provider",
        "icon": "$(trash)"
      },
      {
        "command": "rqml-vscode.slashHelp",
        "title": "RQML: Help (Agent Commands)"
      },
      {
        "command": "rqml-vscode.slashStatus",
        "title": "RQML: Status"
      },
      {
        "command": "rqml-vscode.slashStatusFull",
        "title": "RQML: Status (Full Assessment)"
      },
      {
        "command": "rqml-vscode.slashValidate",
        "title": "RQML: Validate Spec"
      },
      {
        "command": "rqml-vscode.slashLint",
        "title": "RQML: Lint Spec"
      },
      {
        "command": "rqml-vscode.slashScore",
        "title": "RQML: Score Spec"
      },
      {
        "command": "rqml-vscode.slashSync",
        "title": "RQML: Sync Status"
      },
      {
        "command": "rqml-vscode.slashSyncScan",
        "title": "RQML: Sync Scan (Deep)"
      },
      {
        "command": "rqml-vscode.slashPlan",
        "title": "RQML: Plan Implementation"
      },
      {
        "command": "rqml-vscode.slashProviders",
        "title": "RQML: List Providers"
      },
      {
        "command": "rqml-vscode.slashLlm",
        "title": "RQML: LLM Status"
      },
      {
        "command": "rqml-vscode.slashDoctor",
        "title": "RQML: Doctor (Health Check)"
      },
      {
        "command": "rqml-vscode.slashAbout",
        "title": "RQML: About"
      },
      {
        "command": "rqml-vscode.slashModels",
        "title": "RQML: List Models"
      },
      {
        "command": "rqml-vscode.selectModel",
        "title": "RQML: Select Model"
      },
      {
        "command": "rqml-vscode.slashModelTest",
        "title": "RQML: Test Model"
      },
      {
        "command": "rqml-vscode.slashImplement",
        "title": "RQML: Implement Next Stage"
      },
      {
        "command": "rqml-vscode.slashElicit",
        "title": "RQML: Elicit Requirements"
      },
      {
        "command": "rqml-vscode.gateCheck",
        "title": "RQML: Check (run the gate)",
        "icon": "$(shield)"
      },
      {
        "command": "rqml-vscode.gateRepinEdge",
        "title": "RQML: Re-pin Trace Baseline..."
      },
      {
        "command": "rqml-vscode.gateApproveRequirement",
        "title": "RQML: Approve Requirement"
      },
      {
        "command": "rqml-vscode.resolveAmbiguousSpec",
        "title": "RQML: Resolve Ambiguous Spec Directory"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rqmlExplorer",
          "title": "RQML BROWSER",
          "icon": "./resources/rqml.png"
        }
      ],
      "panel": [
        {
          "id": "rqmlPanel",
          "title": "RQML AGENT",
          "icon": "./resources/rqml.png"
        }
      ]
    },
    "views": {
      "rqmlExplorer": [
        {
          "id": "rqmlTree",
          "name": "Overview"
        },
        {
          "id": "rqmlDetails",
          "name": "Details"
        },
        {
          "id": "rqmlTraces",
          "name": "Traces"
        }
      ],
      "rqmlPanel": [
        {
          "id": "rqmlAgentView",
          "name": "RQML AGENT",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rqml-vscode.selectSpec",
          "when": "view == rqmlTree && rqml.hasMultipleSpecs",
          "group": "navigation@0"
        },
        {
          "command": "rqml-vscode.openDocumentView",
          "when": "view == rqmlTree",
          "group": "navigation@1"
        },
        {
          "command": "rqml-vscode.openTraceView",
          "when": "view == rqmlTree",
          "group": "navigation@2"
        },
        {
          "command": "rqml-vscode.openGridView",
          "when": "view == rqmlTree",
          "group": "navigation@3"
        },
        {
          "command": "rqml-vscode.export",
          "when": "view == rqmlTree",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "rqml-vscode.openDocumentView",
          "when": "view == rqmlTree && viewItem == rqmlRoot",
          "group": "inline@1"
        },
        {
          "command": "rqml-vscode.openTraceView",
          "when": "view == rqmlTree && viewItem == rqmlRoot",
          "group": "inline@2"
        },
        {
          "command": "rqml-vscode.openGridView",
          "when": "view == rqmlTree && viewItem == rqmlRoot",
          "group": "inline@3"
        },
        {
          "command": "rqml-vscode.export",
          "when": "view == rqmlTree && viewItem == rqmlRoot",
          "group": "export"
        },
        {
          "command": "rqml-vscode.addItem",
          "when": "view == rqmlTree && (viewItem == rqmlSection || viewItem == rqmlSectionMissing)",
          "group": "inline"
        },
        {
          "command": "rqml-vscode.gotoDefinition",
          "when": "view == rqmlTree && viewItem == rqmlItem",
          "group": "navigation"
        },
        {
          "command": "rqml-vscode.renameItem",
          "when": "view == rqmlTree && viewItem == rqmlItem",
          "group": "editing@1"
        },
        {
          "command": "rqml-vscode.deleteItem",
          "when": "view == rqmlTree && viewItem == rqmlItem",
          "group": "editing@2"
        }
      ]
    },
    "languages": [
      {
        "id": "rqml",
        "aliases": [
          "RQML",
          "rqml"
        ],
        "extensions": [
          ".rqml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rqml",
        "scopeName": "text.xml.rqml",
        "path": "./syntaxes/rqml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "RQML",
      "properties": {
        "rqml.llmProvider": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "openai",
            "anthropic",
            "azure-openai",
            "ollama"
          ],
          "enumDescriptions": [
            "LLM features disabled",
            "OpenAI (GPT models)",
            "Anthropic (Claude models)",
            "Azure OpenAI Service",
            "Ollama (local models)"
          ],
          "description": "Select the LLM provider for AI-assisted features (Ideas view, requirement generation)."
        },
        "rqml.reasoningBudgetTokens": {
          "type": "number",
          "default": 4000,
          "minimum": 1024,
          "maximum": 64000,
          "description": "Maximum tokens the model may spend on reasoning ('thinking') before producing the final answer. Applies to providers that require an explicit budget (e.g. Anthropic extended thinking). Other reasoning-capable providers expose reasoning natively and ignore this setting."
        },
        "rqml.agentMode": {
          "type": "string",
          "default": "build",
          "enum": [
            "spec",
            "build"
          ],
          "enumDescriptions": [
            "Spec mode — RQML Agent will work on spec and design but not implement.",
            "Build mode — RQML Agent works on all parts of the software process, including implementation."
          ],
          "description": "Active operating mode for the RQML Agent. Persists per workspace."
        },
        "rqml.agentStrictness": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "relaxed",
            "standard",
            "strict",
            "certified"
          ],
          "enumDescriptions": [
            "Use AGENTS.md setting or default to 'standard'",
            "Prototyping. Spec is advisory. Quick iteration allowed.",
            "Production default. Spec-first for features. Core traces required.",
            "Full traceability. All behaviour specified. No ghost features.",
            "Regulated/safety-critical. Audit-grade traces with metadata."
          ],
          "description": "Strictness level for the RQML Agent. Overrides AGENTS.md if set."
        },
        "rqml.llmEndpoints": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for this endpoint"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "azure-openai",
                  "google"
                ],
                "description": "LLM provider"
              },
              "name": {
                "type": "string",
                "description": "Display name for this endpoint"
              },
              "model": {
                "type": "string",
                "description": "Model identifier (e.g., gpt-4o, claude-sonnet-4-5-20250929)"
              }
            },
            "required": [
              "id",
              "provider",
              "name"
            ]
          },
          "description": "Configured LLM endpoints for the RQML Agent."
        },
        "rqml.activeEndpointId": {
          "type": "string",
          "default": "",
          "description": "Legacy setting (pre-0.2). Cleared automatically on first activation under the singleton-per-provider architecture."
        },
        "rqml.activeModel": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "The currently active model: { providerId, modelId }. Managed by the RQML Agent — do not edit by hand."
        },
        "rqml.modelSelections": {
          "type": "object",
          "default": {},
          "description": "Selected model per endpoint. Keys are endpoint IDs, values are model IDs.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rqml.modelCatalog.customModels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "modelId": {
                "type": "string",
                "description": "Model identifier passed to the provider SDK"
              },
              "provider": {
                "type": "string",
                "description": "Provider key (e.g. openai, anthropic, google)"
              },
              "displayName": {
                "type": "string",
                "description": "Human-readable display name"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "chat",
                    "code",
                    "vision",
                    "function-calling",
                    "reasoning"
                  ]
                }
              },
              "contextWindow": {
                "type": "number",
                "description": "Context window size in tokens"
              }
            },
            "required": [
              "modelId",
              "provider"
            ]
          },
          "description": "Custom models added to the catalog by the user."
        },
        "rqml.modelCatalog.hiddenModels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Model IDs hidden from the catalog (format: provider/modelId)."
        },
        "rqml.modelCatalog.overrides": {
          "type": "object",
          "default": {},
          "description": "Metadata overrides for default catalog entries. Keys are provider/modelId.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contextWindow": {
                "type": "number"
              }
            }
          }
        },
        "rqml.modelCatalog.fallbackModels": {
          "type": "object",
          "default": {},
          "description": "Optional fallback model per endpoint. Keys are endpoint IDs, values are model IDs.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rqml.gate.blockAgentEdits": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Refuse writes by the built-in RQML agent to files that a trace edge links to a requirement which is not yet approved.\n\n**This governs the built-in agent only.** Edits you make yourself, edits by another extension, and edits by an agent running outside this extension are reported in the Problems panel but are not blocked — no editor API can prevent them. The authoritative gate is `rqml check` in continuous integration."
        }
      }
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/azure": "^4.0.19",
    "@ai-sdk/deepseek": "^3.0.13",
    "@ai-sdk/google": "^4.0.22",
    "@ai-sdk/groq": "^4.0.13",
    "@ai-sdk/mistral": "^4.0.14",
    "@ai-sdk/openai": "^4.0.18",
    "@ai-sdk/perplexity": "^4.0.13",
    "@ai-sdk/xai": "^4.0.18",
    "@rqml/core": "^0.8.0",
    "@rqml/schema": "^0.2.1",
    "ai": "^7.0.35",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node esbuild.js",
    "watch:webview": "node esbuild.js --watch",
    "pretest:integration": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "vscode-test",
    "package": "vsce package --baseImagesUrl https://raw.githubusercontent.com/rqml-org/rqml-vscode/main/extension/ --baseContentUrl https://github.com/rqml-org/rqml-vscode/blob/main/extension/",
    "package:pre": "vsce package --pre-release --baseImagesUrl https://raw.githubusercontent.com/rqml-org/rqml-vscode/main/extension/ --baseContentUrl https://github.com/rqml-org/rqml-vscode/blob/main/extension/",
    "publish": "vsce publish --baseImagesUrl https://raw.githubusercontent.com/rqml-org/rqml-vscode/main/extension/ --baseContentUrl https://github.com/rqml-org/rqml-vscode/blob/main/extension/",
    "publish:pre": "vsce publish --pre-release --baseImagesUrl https://raw.githubusercontent.com/rqml-org/rqml-vscode/main/extension/ --baseContentUrl https://github.com/rqml-org/rqml-vscode/blob/main/extension/"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/pdfkit": "^0.17.6",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
